# ==============================================
# 🚫 ARCHIVOS Y CARPETAS QUE NO DEBEN SUBIRSE
# ==============================================

# 🧠 Entornos virtuales
venv/
.venv/
env/
ENV/

# 📦 Cache y compilados de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# 🔥 NO IGNORAR MODELOS (Render los necesita)
# ❌ NO IGNORAR:
# cnn_model.h5
# regression_model.pkl
# class_indices.json
# training_metrics.json

# 🧪 Dataset (solo el dataset se ignora)
ml_models/dataset/
dataset/
data/

# 📄 Archivos grandes o datos crudos
*.csv
*.xlsx
*.xls
*.npz
*.npy

# 💾 Archivos del sistema
.DS_Store
Thumbs.db

# 🧰 Configuración local
.vscode/
.idea/
.env
.env.*

# 🔧 Cache internas
ml_models/__pycache__/

# 🚀 Archivos temporales / Render
*.log
*.tmp
*.bak
*.swp

# 🧩 Archivos de despliegue / compilación
staticfiles/
*.egg-info/
*.spec

# 🧱 Archivos de backups o pruebas locales
*.old
*.save

# 🔒 PERMITIMOS estos JSON (necesarios)
!ml_models/class_indices.json
!ml_models/training_metrics.json
